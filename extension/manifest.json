{
  "manifest_version": 3,
  "name": "Голосовой ввод",
  "short_name": "Голосовой ввод",
  "version": "1.0.0",
  "description": "Диктовка текста голосом в любые поля сайтов. Google-распознавание, офлайн-режим для Vivaldi, команды пунктуации по-русски.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Голосовой ввод — нажмите, чтобы диктовать (Alt+Shift+V)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "permissions": ["storage", "offscreen", "contextMenus"],
  "host_permissions": ["https://speech.googleapis.com/*", "https://alphacephei.com/*"],
  "commands": {
    "toggle-dictation": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Начать / остановить голосовой ввод"
    },
    "switch-language": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Переключить язык диктовки (русский / English)"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["common/defaults.js", "common/textproc.js", "content/content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
